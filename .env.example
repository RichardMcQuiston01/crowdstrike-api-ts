# Copy to `.env` and fill in real values before running the demo.
# Obtain credentials from https://falcon.crowdstrike.com/api-clients-and-keys/clients

# Required — OAuth2 API client credentials.
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=

# Optional — region key (US1|US2|EU1|USGOV1) or a raw base URL. Defaults to US1.
FALCON_BASE_URL=US1

# Optional — MSSP child CID to act on behalf of.
FALCON_MEMBER_CID=

# Optional — page size for the sample queries (max 20). Defaults to 5.
DEMO_LIMIT=5
